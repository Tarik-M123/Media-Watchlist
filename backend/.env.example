DATABASE_URL=postgresql://postgres:password@localhost:5432/media_watchlist
SECRET_KEY=change-this-to-a-long-random-secret-key

# Used by the API (poster/metadata lookup, title search, streaming providers)
# and by the watchlist-engine MCP server (mcp_server/).
# Free key from https://www.themoviedb.org/settings/api
# Either the v3 API key or the v4 read access token works.
# Without it the app still works: items save, but with no poster or suggestions.
TMDB_API_KEY=

# Country used to look up where a title is streaming (ISO 3166-1). Availability
# is region-specific, so this changes which platforms are offered. Defaults to BA.
WATCH_REGION=BA

# Powers the "ask your watchlist" assistant (POST /assistant/ask).
# Free key, no card required: https://aistudio.google.com/apikey
# Without it the rest of the app works normally: the chat panel explains that
# it is not configured instead of erroring.
# The semantic search behind it needs no key at all — that model runs locally,
# and downloads ~67 MB the first time it is used.
GEMINI_API_KEY=

# Pins the assistant to ONE model. Leave it unset for the default chain
# (gemini-flash-latest, then two more), which falls through on a 429 — free-tier
# quota is counted per model, so each entry is a fresh allowance.
#
# Setting this disables that fallback. Worth it only if you need reproducible
# behaviour more than headroom, and note pinned names do get retired:
# gemini-2.5-flash already 404s for new keys.
# GEMINI_MODEL=gemini-flash-latest
